# Slack-Backbone — Environment Variables Example
# Copy to .env.local and fill in your values.
# This file is NOT tracked by git (see .dockerignore).
#
# Note: Primary token configuration comes from teams.yaml.
# These env vars are read as fallback/overrides via godotenv.

# Global Slack tokens (fallback, per-team tokens come from teams.yaml)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Operation mode: "cli" or "mcp"
MODE=cli

# HTTP port for MCP streamable transport (MCP mode only, default 0 = disabled)
HTTP_PORT=8080

# Log level: debug | info | warn | error (default: info)
SLACK_BACKBONE_LOG_LEVEL=info

# Path to teams.yaml config file (overrides --config CLI flag)
SLACK_BACKBONE_CONFIG_FILE=/etc/slack-backbone/teams.yaml
